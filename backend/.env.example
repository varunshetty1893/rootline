# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rootline

# JWT
SECRET_KEY=replace-this-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Password reset
RESET_TOKEN_EXPIRE_MINUTES=30

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend base URL (used for CORS + post-auth redirects)
FRONTEND_URL=http://localhost:5173

# Runtime environment and optional SMTP delivery for password resets
ENVIRONMENT=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
LOG_RESET_LINKS=false

# Optional rate-limit tuning
AUTH_IP_PER_MINUTE=20
AUTH_ACCOUNT_PER_MINUTE=8
AUTH_BASE_BACKOFF_SECONDS=1
AUTH_MAX_BACKOFF_SECONDS=300
PUBLIC_REQUESTS_PER_MINUTE=60
AUTHENTICATED_READS_PER_MINUTE=120
AUTHENTICATED_WRITES_PER_MINUTE=60
