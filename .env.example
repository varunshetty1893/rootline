# Server Configuration
PORT=3000
NODE_ENV=development
SECRET_KEY=
COOKIE_SAMESITE=lax
FRONTEND_URL=
ALLOWED_ORIGINS=

# Auth & Tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

# AI Services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database & Cache (Optional: defaults to In-Memory store if unset)
DATABASE_URL=
REDIS_URL=
SEED_DEMO_DATA=true
BCRYPT_ROUNDS=12

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SMTP Email Service (Optional: for password resets & invites)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
CONTACT_EMAIL=
LOG_RESET_LINKS=false

# Rate Limit Configuration
AUTH_IP_PER_MINUTE=20
AUTH_ACCOUNT_PER_MINUTE=8
AUTH_BASE_BACKOFF_SECONDS=1
AUTH_MAX_BACKOFF_SECONDS=300
PUBLIC_REQUESTS_PER_MINUTE=60
AUTHENTICATED_READS_PER_MINUTE=120
AUTHENTICATED_WRITES_PER_MINUTE=60

# Client Configuration
VITE_API_URL=
