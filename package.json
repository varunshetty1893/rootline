{
  "name": "rootline-register",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.383.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^5.2.0",
    "vitest": "^3.2.4"
  }
}
