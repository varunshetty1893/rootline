{
  "name": "rootline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/rootline/vite.config.ts",
    "build:client": "vite build --config artifacts/rootline/vite.config.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node server.ts",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/genai": "^2.22.0",
    "@replit/connectors-sdk": "^0.4.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.383.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^5.2.0"
  }
}
